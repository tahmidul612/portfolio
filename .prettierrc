{
  "plugins": ["prettier-plugin-go-template"],
  "overrides": [
    {
      "files": ["layouts/**/*.html"],
      "options": {
        "parser": "go-template",
        "bracketSameLine": true
      }
    },
    {
      "files": ["content/**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
