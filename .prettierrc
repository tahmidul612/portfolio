{
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": ["src/**", "astro.config.mjs"],
      "options": {
        "printWidth": 100
      }
    },
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": ["content/**/*.mdx", "content/**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
