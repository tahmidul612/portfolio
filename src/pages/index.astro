---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "@components/Icon.astro";
import ProjectItem from "@components/ProjectItem.astro";
import { projectsIn } from "@lib/projects";
import { email } from "@lib/site";
import profile from "../assets/profile.jpg";

const work = await projectsIn("work");
const featured = (await projectsIn("personal")).filter((p) => p.data.featured);
const [current] = work;
---

<Base>
  <!-- Compact on phones so the first project starts on the first screen. -->
  <section class="wrap hero">
    <div class="hero__id rise">
      <div class="avatar">
        <Image src={profile} alt="" width={160} height={160} priority />
      </div>
      <h1 class="hero__name">Tahmidul Islam</h1>
    </div>
    <p class="hero__role rise" style="--i: 1">
      Automation engineer at <a href={`/projects/${current.id}/`}>Raphael Porcelain</a>, working
      remotely from Toronto.
    </p>
    <p class="hero__bio rise" style="--i: 2">
      Right now that means building n8n workflows, AI pipelines, and internal web apps for a
      porcelain tile wholesaler.
    </p>
    <div class="hero__cta rise" style="--i: 3">
      <a class="btn btn--primary" href="/resume/">
        <Icon name="file" />
        Resume
      </a>
      <a class="btn btn--icon" href="https://github.com/tahmidul612" rel="me noopener">
        <Icon name="github" />
        <span class="visually-hidden">GitHub</span>
      </a>
      <a class="btn btn--icon" href="https://linkedin.com/in/tahmidul612" rel="me noopener">
        <Icon name="linkedin" />
        <span class="visually-hidden">LinkedIn</span>
      </a>
    </div>
  </section>

  <section class="wrap block block--first" aria-labelledby="selected">
    <h2 class="section-head" id="selected">
      Selected projects
    </h2>
    <div class="features">
      {featured.map((p) => (
        <ProjectItem project={p} layout="feature" />
      ))}
    </div>
    <a class="more link" href="/projects/">
      Everything else I've built <Icon name="arrow-right" />
    </a>
  </section>

  <section class="wrap block" aria-labelledby="experience">
    <h2 class="section-head" id="experience">
      Experience
    </h2>
    <ol class="timeline">
      {work.map((p) => (
        <li class="lit">
          <a href={`/projects/${p.id}/`}>
            <span class="timeline__org">{p.data.title}</span>
            <span class="timeline__role">{p.data.role}</span>
            <span class="timeline__period">{p.data.period}</span>
          </a>
        </li>
      ))}
      <li class="timeline__edu">
        <span class="timeline__org">Lakehead University</span>
        <span class="timeline__role">HBSc Computer Science</span>
        <span class="timeline__period">2019 – 2024</span>
      </li>
    </ol>
  </section>

  <section class="wrap block reach">
    <p>Want to talk about any of this?</p>
    <div class="reach__actions">
      <a class="btn btn--primary" href={`mailto:${email}`}>
        <Icon name="mail" />
        {email}
      </a>
      <a class="btn" href="/contact/">
        Contact card and socials
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(2rem, 8vw, 6.5rem);
  }
  .hero__id {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }
  /* Portrait inside a ring of light. */
  .avatar {
    width: clamp(3.75rem, 11vw, 6.5rem);
    aspect-ratio: 1;
    flex: none;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(
      from 210deg,
      var(--glow),
      var(--accent),
      color-mix(in oklch, var(--glow) 10%, transparent),
      var(--glow)
    );
    box-shadow: 0 0 40px -6px color-mix(in oklch, var(--glow) 55%, transparent);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg);
  }
  .hero__name {
    font-size: clamp(2rem, 1rem + 5.5vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .hero__role {
    margin: clamp(1.1rem, 3vw, 1.75rem) 0 0;
    max-width: 34ch;
    font: 400 var(--step-2) / 1.3 var(--font-display);
    letter-spacing: -0.015em;
  }
  .hero__role a {
    color: var(--glow-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--glow) 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 200ms var(--ease-out);
  }
  .hero__role a:hover {
    text-decoration-color: var(--glow);
  }
  .hero__bio {
    margin: 0.9rem 0 0;
    max-width: 52ch;
    color: var(--text-2);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .block {
    margin-top: clamp(3.5rem, 9vw, 6rem);
  }
  .block--first {
    margin-top: clamp(2.5rem, 7vw, 5rem);
  }
  .features {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-top: 1.25rem;
    font-weight: 500;
  }
  .more :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  /* Experience: one line per role, a hairline of light down the left. */
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 1.5rem;
    list-style: none;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 0.3rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: linear-gradient(var(--glow), var(--line) 60%, transparent);
  }
  .timeline li {
    position: relative;
    border-radius: var(--radius-sm);
  }
  .timeline li::after {
    content: "";
    position: absolute;
    left: calc(-1.5rem + 0.3rem - 3.5px);
    top: 1.35rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--glow);
  }
  .timeline li:first-child::after {
    background: var(--glow);
    box-shadow: 0 0 10px var(--glow);
  }
  .timeline a,
  .timeline__edu {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 1rem;
    padding: 0.85rem 0.75rem;
    text-decoration: none;
  }
  .timeline__org {
    font-weight: 600;
  }
  .timeline__role {
    grid-row: 2;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .timeline__period {
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--text-3);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Phones: the dates drop under the role so names keep the full width. */
  @media (max-width: 30rem) {
    .timeline a,
    .timeline__edu {
      grid-template-columns: 1fr;
    }
    .timeline__period {
      grid-row: auto;
      margin-top: 0.15rem;
    }
  }
  .timeline a .timeline__org {
    transition: color 200ms var(--ease-out);
  }
  .timeline a:hover .timeline__org {
    color: var(--glow-text);
  }

  .reach {
    padding-block: clamp(2rem, 6vw, 3.5rem);
    border-top: 1px solid color-mix(in oklch, var(--line) 60%, transparent);
  }
  .reach p {
    margin: 0;
    max-width: 18ch;
    font: 400 var(--step-3) / 1.15 var(--font-display);
    letter-spacing: -0.035em;
  }
  .reach__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
</style>
