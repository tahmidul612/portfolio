---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Badges from "@components/Badges.astro";
import Icon from "@components/Icon.astro";
import Links from "@components/Links.astro";
import Tech from "@components/Tech.astro";
import { projectsIn, type Project } from "@lib/projects";

export async function getStaticPaths() {
  const pages = await getCollection("projects", (p) => p.data.group !== "smaller");
  return pages.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const { title, summary, links, tech, period, group } = project.data;

// Next project in the same order as the overview, wrapping around.
const order = [...(await projectsIn("work")), ...(await projectsIn("personal"))];
const next = order[(order.findIndex((p) => p.id === project.id) + 1) % order.length];
---

<Base title={title} description={summary}>
  <article class="wrap page">
    <a class="back link" href="/projects/">
      <Icon name="arrow-left" />
      Projects
    </a>
    <header class="page__head">
      <p class="page__kind">
        {group === "work" ? "Work" : "Personal project"}
        {period && ` · ${period}`}
      </p>
      <h1 style={`view-transition-name: title-${project.id}`}>{title}</h1>
      {summary && <p class="page__dek">{summary}</p>}
      <div class="page__meta">
        <Badges project={project} long />
      </div>
      <Links links={links} />
    </header>

    <div class="prose page__body">
      <Content />
    </div>

    <Tech items={tech} />

    <nav class="next" aria-label="Next project">
      <a class="next__link lit" href={`/projects/${next.id}/`}>
        <span class="next__label">Next project</span>
        <span class="next__title">{next.data.title}</span>
        <Icon name="arrow-right" />
      </a>
    </nav>
  </article>
</Base>

<style>
  .page {
    padding-top: clamp(1.5rem, 5vw, 3rem);
  }
  .page > * {
    max-width: var(--measure);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }
  .back :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .page__head {
    margin: clamp(2rem, 6vw, 3.5rem) 0 clamp(2rem, 5vw, 3rem);
  }
  .page__kind {
    margin: 0 0 0.9rem;
    color: var(--glow-text);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .page__head h1 {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
  }
  .page__dek {
    margin: 1.1rem 0 0;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .page__meta {
    margin-top: 1.25rem;
  }
  .page__meta:empty {
    display: none;
  }
  /* Media inside the body may run wider than the text column. */
  .page__body {
    max-width: none;
  }
  .page__body > :global(*:not(.pdemo):not(.pvideo)) {
    max-width: var(--measure);
  }
  .page__body > :global(.pvideo) {
    max-width: 52rem;
  }

  .next {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }
  .next__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 1.25rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 250ms var(--ease-out);
  }
  .next__link:hover {
    border-color: color-mix(in oklch, var(--glow) 60%, var(--line));
  }
  .next__label {
    grid-column: 1;
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .next__title {
    grid-column: 1;
    font: 500 var(--step-1) / 1.3 var(--font-display);
    letter-spacing: -0.02em;
  }
  .next__link :global(.icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--glow-text);
  }
</style>
