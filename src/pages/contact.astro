---
import Base from "../layouts/Base.astro";
import Icon from "@components/Icon.astro";
import VCard from "@components/VCard.astro";
import { email, socials } from "@lib/site";

const rows = [
  { label: "Email", handle: email, url: `mailto:${email}`, icon: "mail" as const },
  ...socials,
];
---

<Base
  title="Contact"
  description="How to reach me: email, socials, and a downloadable contact card."
>
  <section class="wrap contact">
    <h1 class="rise">Contact</h1>
    <p class="lead rise" style="--i: 1">
      Email is the fastest way to reach me. Everything else works too.
    </p>
    <div class="grid">
      <ul class="rows rise" style="--i: 2">
        {rows.map((r) => (
          <li>
            <a class="row lit" href={r.url} rel={r.icon === "mail" ? undefined : "me noopener"}>
              <Icon name={r.icon} />
              <span class="row__label">{r.label}</span>
              <span class="row__handle">{r.handle}</span>
              <Icon name="arrow-up-right" class="row__go" />
            </a>
          </li>
        ))}
      </ul>
      <div class="rise" style="--i: 3">
        <VCard />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-top: clamp(3rem, 8vw, 5rem);
  }
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.045em;
  }
  .lead {
    margin: 1.25rem 0 0;
    max-width: 28ch;
    font: 400 var(--step-2) / 1.3 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--text-2);
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 6vw, 3.5rem);
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: start;
      gap: 4rem;
    }
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li + li {
    border-top: 1px solid color-mix(in oklch, var(--line) 70%, transparent);
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "icon label go" "icon handle go";
    align-items: center;
    column-gap: 1rem;
    padding: 1rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .row > :global(.icon:first-child) {
    grid-area: icon;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--glow-text);
  }
  .row__label {
    grid-area: label;
    font-weight: 500;
  }
  .row__handle {
    grid-area: handle;
    color: var(--text-3);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  .row :global(.row__go) {
    grid-area: go;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--text-3);
    transition:
      transform 400ms var(--ease-out-expo),
      color 200ms var(--ease-out);
  }
  .row:hover :global(.row__go) {
    color: var(--glow-text);
    transform: translate(2px, -2px);
  }
</style>
