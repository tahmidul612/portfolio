---
// Muted explainer video. The MP4 is served from R2 (mediaBase): Pages
// ignores Range requests, and iOS Safari won't play video without them.
// Run tools/upload-media.sh after re-rendering. The poster and captions are
// served from this site. Plays while on screen unless the visitor prefers
// reduced motion or paused it.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { mediaBase } from "@lib/projects";

interface Props {
  /** Path under the media bucket, e.g. /projects/edwin/explainer.mp4 */
  src: string;
  poster: ImageMetadata;
  captions?: string;
  caption?: string;
}
const { src, poster, captions, caption } = Astro.props;
const posterImg = await getImage({ src: poster, width: 1280, format: "webp" });
---

<figure class="pvideo">
  <video
    muted
    playsinline
    loop
    controls
    preload="none"
    data-autoplay
    poster={posterImg.src}
    width={poster.width}
    height={poster.height}
  >
    <source src={`${mediaBase}${src}`} type="video/mp4" />
    {captions && <track kind="captions" src={captions} srclang="en" label="English" />}
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const videos = document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]");
  if (!calm && videos.length && "IntersectionObserver" in window) {
    const autoPaused = new WeakSet<HTMLVideoElement>();
    const userPaused = new WeakSet<HTMLVideoElement>();
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement;
          if (userPaused.has(v)) continue;
          if (isIntersecting) v.play().catch(() => {});
          else if (!v.paused) {
            autoPaused.add(v);
            v.pause();
          }
        }
      },
      { threshold: 0.5 },
    );
    for (const v of videos) {
      v.addEventListener("pause", () => {
        if (autoPaused.has(v)) autoPaused.delete(v);
        else userPaused.add(v);
      });
      v.addEventListener("play", () => userPaused.delete(v));
      watcher.observe(v);
    }
  }
</script>

<style>
  .pvideo {
    margin: 0 0 2.5rem;
  }
  video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-sunk);
    box-shadow: 0 30px 80px -40px color-mix(in oklch, var(--glow) 45%, transparent);
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--text-3);
    font-size: var(--step--1);
  }
</style>
