---
// Repo and site links for a project, as one row of pills.
import Icon from "./Icon.astro";

interface Props {
  links: { label: string; url: string }[];
}
const { links } = Astro.props;
---

{links.length > 0 && (
  <ul class="links">
    {links.map(({ label, url }) => {
      const gh = url.includes("github.com");
      return (
        <li>
          <a class="btn" href={url} rel="noopener">
            <Icon name={gh ? "github" : "arrow-up-right"} />
            {label}
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links .btn {
    min-height: 2.4rem;
    padding-block: 0.4rem;
    font-size: 0.875rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
