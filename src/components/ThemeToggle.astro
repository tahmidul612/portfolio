---
import Icon from "./Icon.astro";
---

<button class="theme" type="button" aria-label="Switch colour theme" data-theme-toggle>
  <Icon name="sun" class="theme__sun" />
  <Icon name="moon" class="theme__moon" />
</button>

<script>
  // Flip to the opposite of what's showing and remember it. Until the
  // visitor picks, the site follows the device.
  const root = document.documentElement;
  for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
    btn.addEventListener("click", () => {
      const dark =
        root.dataset.theme === "dark" ||
        (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
      const next = dark ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
      };
      // Cross-fade where supported.
      if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.startViewTransition(apply);
      else apply();
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>

<style>
  .theme {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }
  .theme:hover {
    color: var(--glow-text);
    border-color: var(--line);
  }
  .theme :global(.icon) {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    transition:
      opacity 300ms var(--ease-out),
      transform 500ms var(--ease-out-expo);
  }
  /* Show the moon in light mode (go dark) and the sun in dark mode. */
  .theme :global(.theme__sun) {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme :global(.theme__sun) {
      opacity: 1;
      transform: none;
    }
    :global(:root:not([data-theme="light"])) .theme :global(.theme__moon) {
      opacity: 0;
      transform: rotate(60deg) scale(0.6);
    }
  }
  :global(:root[data-theme="dark"]) .theme :global(.theme__sun) {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme="dark"]) .theme :global(.theme__moon) {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
</style>
