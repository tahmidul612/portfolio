---
// The downloadable contact card. Name, title and company are read from
// static/vcard.vcf, so the page and the file it serves never drift apart.
import { readFileSync } from "node:fs";
import Icon from "./Icon.astro";

interface Props {
  src?: string;
  href?: string;
  download?: string;
}
const { src = "static/vcard.vcf", href = "/vcard", download = "Tahmidul_Islam.vcf" } = Astro.props;

const fields = Object.fromEntries(
  readFileSync(src, "utf8")
    .split(/\r?\n/)
    .map((line) => line.match(/^(FN|TITLE|ORG):(.*)$/))
    .filter((m) => m !== null)
    // vCard escapes commas and semicolons; ORG may list units after a ";".
    .map(([, key, value]) => [
      key,
      (key === "ORG" ? value.split(/(?<!\\);/)[0] : value).replace(/\\([,;])/g, "$1"),
    ]),
);
const { FN: name, TITLE: role, ORG: org } = fields;
---

<a class="vcard lit" href={href} download={download} aria-label={`Save ${name} as a contact card`}>
  <span class="vcard__identity">
    <span class="vcard__name">{name}</span>
    {role && <span class="vcard__role">{role}</span>}
    {org && <span class="vcard__org">{org}</span>}
  </span>
  <span class="vcard__action">
    <Icon name="download" class="vcard__icon" />
    <span>Save contact card</span>
    <span class="vcard__ext">.vcf</span>
  </span>
</a>

<style>
  .vcard {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 24rem;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--bg-raised) 75%, transparent);
    text-decoration: none;
    transition:
      border-color 250ms var(--ease-out),
      transform 250ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }
  .vcard:hover {
    border-color: color-mix(in oklch, var(--glow) 60%, var(--line));
    transform: translateY(-2px);
    box-shadow: 0 24px 60px -30px color-mix(in oklch, var(--glow) 50%, transparent);
  }
  .vcard__identity {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .vcard__name {
    font: 500 var(--step-1) / 1.3 var(--font-display);
    letter-spacing: -0.02em;
  }
  .vcard__role,
  .vcard__org {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .vcard__action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--accent-strong);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .vcard__action :global(.vcard__icon) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 250ms var(--ease-out);
  }
  /* The arrow moves the way the file does: down, onto the device. */
  .vcard:hover :global(.vcard__icon) {
    transform: translateY(2px);
  }
  .vcard__ext {
    margin-left: auto;
    color: var(--text-3);
    font-size: 0.8125rem;
    font-weight: 400;
  }
</style>
