---
// One project on a list. With a thumbnail it's a feature: image and text side
// by side (stacked on phones). Without one it's a compact row. Every row in
// a list has the same shape, so the list reads evenly.
import { Image } from "astro:assets";
import { hasVideo } from "@lib/projects";
import Badges from "./Badges.astro";
import Icon from "./Icon.astro";
import type { Project } from "@lib/projects";

interface Props {
  project: Project;
  layout?: "feature" | "row";
}
const { project, layout = project.data.thumbnail ? "feature" : "row" } = Astro.props;
const { title, summary, thumbnail, thumbnailAlt, period } = project.data;
const href = `/projects/${project.id}/`;
const hasBadges = Boolean(project.data.status || project.data.demo || hasVideo(project));
---

<article class:list={["item", "lit", `item--${layout}`]}>
  {layout === "feature" && thumbnail && (
    <div class="item__media">
      <Image
        src={thumbnail}
        alt={thumbnailAlt ?? ""}
        width={720}
        widths={[360, 540, 720, 1080]}
        sizes="(min-width: 44rem) 30rem, 100vw"
        style={`view-transition-name: media-${project.id}`}
      />
    </div>
  )}
  <div class="item__body">
    <div class="item__top">
      <h3 class="item__title">
        <a href={href} style={`view-transition-name: title-${project.id}`}>
          {title}
        </a>
      </h3>
      {!hasBadges && <Icon name="arrow-right" class="item__arrow" />}
    </div>
    {period && <p class="item__period">{period}</p>}
    {summary && <p class="item__summary">{summary}</p>}
    {hasBadges && (
      <div class="item__foot">
        <Badges project={project} />
        <Icon name="arrow-right" class="item__arrow" />
      </div>
    )}
  </div>
</article>

<style>
  .item {
    border-radius: var(--radius);
    transition: background-color 300ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  /* Tap feedback on touch screens, where there is no hover. */
  .item:active {
    background-color: color-mix(in oklch, var(--glow) 7%, transparent);
    transition-duration: 0ms;
  }
  /* The whole item is the link target; the title link stretches over it. */
  .item__title a {
    text-decoration: none;
  }
  .item__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .item__title a:focus-visible {
    outline: none;
  }
  .item:has(a:focus-visible) {
    outline: 2px solid var(--glow);
    outline-offset: 2px;
  }
  .item__title {
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .item__period {
    margin: 0.3rem 0 0;
    color: var(--glow-text);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .item__summary {
    margin: 0.5rem 0 0;
    color: var(--text-2);
    max-width: 60ch;
  }
  .item__foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.9rem;
    min-height: 1.6rem;
  }
  .item__top {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .item__top :global(.item__arrow) {
    align-self: center;
  }
  .item__foot :global(.badges) {
    flex: 1;
  }
  .item :global(.item__arrow) {
    margin-left: auto;
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--text-3);
    transition:
      transform 400ms var(--ease-out-expo),
      color 200ms var(--ease-out);
  }
  .item:hover :global(.item__arrow) {
    color: var(--glow-text);
    transform: translateX(4px);
  }

  /* Compact row: hairline between rows, generous touch target. */
  .item--row {
    padding: 1.25rem 1rem;
    margin-inline: -1rem;
  }
  .item--row + :global(.item--row) {
    border-top: 1px solid color-mix(in oklch, var(--line) 70%, transparent);
    border-radius: 0;
  }

  /* Feature: image on top on phones, beside the text from tablet up. */
  .item--feature {
    display: grid;
    gap: 1.1rem;
    padding: 0.75rem;
    margin-inline: -0.75rem;
  }
  .item__media {
    overflow: hidden;
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid var(--line);
    aspect-ratio: 16 / 10;
    background: var(--bg-sunk);
  }
  .item__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }
  .item--feature:hover .item__media :global(img) {
    transform: scale(1.03);
  }
  @media (min-width: 44rem) {
    .item--feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 2.25rem;
    }
    .item--feature .item__title {
      font-size: var(--step-2);
    }
    /* Alternate sides down the list for rhythm. */
    .item--feature:nth-child(even) {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .item--feature:nth-child(even) .item__media {
      order: 2;
    }
  }
</style>
