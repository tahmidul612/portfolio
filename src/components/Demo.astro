---
// Click-to-load interactive demo. The iframe only loads after a tap, so a
// long page stays light. src is a page under static/demos/ or a URL.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
  src: string;
  title?: string;
  poster?: ImageMetadata;
  /** Aspect ratio on wide screens. Phones get a taller frame. */
  ratio?: string;
}
const { src, title = "Interactive demo", poster, ratio = "16 / 10" } = Astro.props;
---

<figure class="pdemo" style={`--ratio: ${ratio}`}>
  <div class="pdemo__frame" data-src={src} data-title={title}>
    {poster && <Image class="pdemo__poster" src={poster} alt="" width={1400} />}
    <button class="btn btn--primary pdemo__play" type="button">
      <Icon name="play" />
      Try the demo
      <span class="visually-hidden">: {title}</span>
    </button>
  </div>
  <figcaption>
    {title} ·
    <a class="link" href={src} target="_blank" rel="noopener">
      Open full screen <Icon name="arrow-up-right" />
    </a>
  </figcaption>
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>(".pdemo__frame")) {
    frame.querySelector(".pdemo__play")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = frame.dataset.src!;
      iframe.title = frame.dataset.title!;
      iframe.allow = "fullscreen; autoplay";
      // Our own demos are trusted pages on this origin. Third-party sites get
      // a sandbox, where allow-same-origin keeps their own origin, not this one.
      if (new URL(iframe.src, location.href).origin !== location.origin) {
        iframe.setAttribute("sandbox", "allow-scripts allow-same-origin allow-popups allow-forms");
      }
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .pdemo {
    margin: 2.5rem 0;
  }
  .pdemo__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-sunk);
  }
  @media (min-width: 40rem) {
    .pdemo__frame {
      aspect-ratio: var(--ratio);
    }
  }
  /* Give the demo room for its desktop layout on wide screens. */
  @media (min-width: 70rem) {
    .pdemo {
      width: min(64rem, calc(100vw - 2 * var(--gutter)));
    }
  }
  .pdemo__frame :global(iframe),
  .pdemo__frame :global(.pdemo__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .pdemo__frame :global(.pdemo__poster) {
    filter: saturate(0.9) brightness(0.8);
  }
  .pdemo__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    cursor: pointer;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--text-3);
    font-size: var(--step--1);
  }
  figcaption .link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  figcaption :global(.icon) {
    width: 0.9em;
    height: 0.9em;
  }
</style>
